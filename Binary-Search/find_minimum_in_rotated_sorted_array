class Solution:
    def findMin(self, nums: List[int]) -> int:
        if len(nums) == 1 or nums[0] < nums[-1]:
            return nums[0]  #Edge case where we have just one element or original sorted array
        
        
        l, r = 0, len(nums) - 1

        while l < r:
            mid = (l + r) // 2

            if nums[mid] > nums[r]:
                l = mid + 1
            
            else:
                r = mid
        
        return nums[l]

# Time Complexity - O(log n)
# Space Complexity - O(1)